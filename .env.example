# Shared
NODE_ENV=development

# Apps
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kashmir_tyre_house

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Email
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL_FROM=
ENQUIRY_TO_EMAIL=
# Optional: comma-separated extra recipients CC'd on enquiry notifications
ENQUIRY_CC_EMAIL=

# Admin auth, when NextAuth is enabled
AUTH_SECRET=
ADMIN_PASSWORD_RESET_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Feature flags
# Switch a whole module off across the website, admin portal, and API without
# touching code — set the variable to `false` and redeploy.
# Leaving a variable unset (or empty) means the module is ENABLED.
# Accepted: true/1/on/yes/enabled | false/0/off/no/disabled
# An unrecognised value fails the build on purpose, so typos can't silently
# leave a module switched on.
FEATURE_PRODUCTS=true
FEATURE_ENQUIRIES=true
# bookmarks and compare require FEATURE_PRODUCTS — they switch off with it.
FEATURE_BOOKMARKS=true
FEATURE_COMPARE=true
FEATURE_BRANDS=true
FEATURE_GALLERY=true
FEATURE_SERVICES=true
FEATURE_ABOUT=true
FEATURE_CUSTOMERS=true
